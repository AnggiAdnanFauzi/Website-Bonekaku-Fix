# ==========================================
# SENSITIVE FILES & CREDENTIALS (DO NOT PUSH)
# ==========================================
.env
.env.*
!.env.example
*.key
auth.json
PANDUAN_DEPLOYMENT_CPANEL.md
*cpanel*
*CPANEL*

# ==========================================
# DATABASE FILES & DUMPS (SENSITIVE)
# ==========================================
*.sql
*.sqlite
*.sqlite3
*.db

# ==========================================
# ARCHIVES & BACKUPS (LARGE FILES >100MB)
# ==========================================
*.zip
*.tar
*.gz
*.rar
*.7z
*.bak

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
vendor/

# ==========================================
# BUILD OUTPUTS & COMPILED ASSETS
# ==========================================
dist/
dist-ssr/
build/
.output/
/public/build
/public/hot

# ==========================================
# LARAVEL STORAGE & CACHE
# ==========================================
storage/*.key
storage/pail/
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
public/storage

# ==========================================
# LOGS
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# OS & IDE METADATA
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Homestead.json
Homestead.yaml
.phpunit.result.cache
.fleet/
.nova/
.zed/
